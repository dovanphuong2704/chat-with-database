# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# Application database (stores users, API keys, connections)
# Default: SQLite local file. Can point to a PostgreSQL instance.
APP_DB_URL=sqlite:///app.db

# Encryption key for stored API keys and DB passwords (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# AI Provider API Keys (configured per-user in the app UI, not required here)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
